    function applyTheme() {
      const root = document.documentElement;
      const prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
      const isDark = state.theme === "dark" || (state.theme === "system" && prefersDark);

      root.classList.toggle("dark", isDark);
      document.body.style.setProperty("--page-bg", isDark ? "#101616" : "#faf8f4");

      const iconMap = {
        system: `<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
        light: `<svg class="w-3.5 h-3.5 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>`,
        dark: `<svg class="w-3.5 h-3.5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>`
      };
      const labelMap = { system: "Auto", light: "Light", dark: "Dark" };
      $("themeIcon").innerHTML = iconMap[state.theme];
      $("themeLabel").textContent = labelMap[state.theme];
    }

    if (window.matchMedia) {
      window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
        if (state.theme === "system") applyTheme();
      });
    }

    /**
     * =========================================================================
     * OFFLINE SVG ROUTE MAP WITH SMART PIN DE-CLUSTERING
     * =========================================================================
     */
    function buildOfflineSvgMap(coreStops, legs, shortlistedAlts) {
      const allMapPoints = [...coreStops, ...shortlistedAlts];
      if (!allMapPoints.length) return "";

      const W = 360;
      const H = 225;
      const PAD = 30;

      const lats = allMapPoints.map((s) => s.lat);
      const lngs = allMapPoints.map((s) => s.lng);
      const midLat = lats.reduce((a, b) => a + b, 0) / lats.length;
      const cosLat = Math.cos((midLat * Math.PI) / 180);

      const minLng = Math.min(...lngs);
      const minLat = Math.min(...lats);
      const spanLng = Math.max(...lngs) - minLng || 0.012;
      const spanLat = Math.max(...lats) - minLat || 0.012;

      const scale = Math.min((W - 2 * PAD) / (spanLng * cosLat), (H - 2 * PAD) / spanLat);
      const offsetX = (W - spanLng * cosLat * scale) / 2;
      const offsetY = (H - spanLat * scale) / 2;

      const project = (lat, lng) => [
        offsetX + (lng - minLng) * cosLat * scale,
        H - offsetY - (lat - minLat) * scale
      ];

      const rawPts = allMapPoints.map((s) => project(s.lat, s.lng));
      const displayPts = rawPts.map((p) => [...p]);
      const visited = new Array(rawPts.length).fill(false);

      // Fan out overlapping pins radially so every pin badge stays legible
      for (let i = 0; i < rawPts.length; i++) {
        if (visited[i]) continue;
        const cluster = [i];
        visited[i] = true;
        for (let j = i + 1; j < rawPts.length; j++) {
          if (visited[j]) continue;
          const dist = Math.hypot(rawPts[i][0] - rawPts[j][0], rawPts[i][1] - rawPts[j][1]);
          if (dist < 16) {
            cluster.push(j);
            visited[j] = true;
          }
        }
        if (cluster.length > 1) {
          const radius = cluster.length === 2 ? 10 : 13.5;
          cluster.forEach((idx, k) => {
            const angle = (2 * Math.PI * k) / cluster.length - Math.PI / 4;
            displayPts[idx][0] = Math.max(16, Math.min(W - 16, rawPts[idx][0] + Math.cos(angle) * radius));
            displayPts[idx][1] = Math.max(16, Math.min(H - 16, rawPts[idx][1] + Math.sin(angle) * radius));
          });
        }
      }

      let landSvg = "";
      if (spanLat > 0.22) {
        const coastPts = COASTLINE.map((c) => project(c[0], c[1]).map((n) => n.toFixed(1)).join(",")).join(" ");
        landSvg = `<polygon points="${coastPts}" class="fill-[#e9e2cf] dark:fill-[#22302e] stroke-[#94a3b8] dark:stroke-[#475569]" stroke-width="1.2" />`;
      } else {
        landSvg = `<circle cx="${W * 0.72}" cy="${H * 0.25}" r="140" class="fill-[#efe9da]/60 dark:fill-[#1c2827]/60" />`;
      }

      // Draw driving segments between core stops
      const segmentsSvg = legs
        .map((leg, i) => {
          const p1 = displayPts[i];
          const p2 = displayPts[i + 1];
          if (!p1 || !p2) return "";
          const color = legSpeedColor(leg[1]).hex;
          return `<line x1="${p1[0].toFixed(1)}" y1="${p1[1].toFixed(1)}" x2="${p2[0].toFixed(1)}" y2="${p2[1].toFixed(1)}" stroke="${color}" stroke-width="3.2" stroke-linecap="round" stroke-opacity="0.9" />`;
        })
        .join("");

      // Core numbered pins + Starred shortlisted alternate pins
      const pinsSvg = displayPts
        .map((pt, i) => {
          const item = allMapPoints[i];
          const isCore = i < coreStops.length;
          const fill = STOP_TYPES[item.type]?.color || "#0e7c7b";
          const label = isCore ? `${i + 1}` : "★";
          const opacity = isCore && !state.shortlist[item.id] ? "0.45" : "1";
          return `
            <g opacity="${opacity}">
              <circle cx="${pt[0].toFixed(1)}" cy="${pt[1].toFixed(1)}" r="${isCore ? 10.5 : 9}" fill="${fill}" stroke="#ffffff" stroke-width="1.8" />
              <text x="${pt[0].toFixed(1)}" y="${(pt[1] + 3.5).toFixed(1)}" fill="#ffffff" font-size="${isCore ? 10 : 9}" font-weight="800" font-family="Inter, sans-serif" text-anchor="middle">${label}</text>
            </g>
          `;
        })
        .join("");

      return `
        <div class="relative rounded-2xl overflow-hidden border border-sand-200 dark:border-slate-700/80 bg-[#dcecf2] dark:bg-[#132229]">
          <svg viewBox="0 0 ${W} ${H}" class="w-full h-auto block" role="img" aria-label="Offline route map">
            ${landSvg}
            ${segmentsSvg}
            ${pinsSvg}
          </svg>
          <span class="absolute top-2.5 right-2.5 px-2 py-0.5 rounded-full text-[10px] font-bold bg-white/85 dark:bg-slate-900/80 text-slate-700 dark:text-slate-200 backdrop-blur-xs shadow-xs">
            Offline SVG + ★ Picks
          </span>
        </div>
      `;
    }

