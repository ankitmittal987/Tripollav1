    /**
     * =========================================================================
     * TAB 3: MULTI-CURRENCY EXPENSE SPLITTER (LKR, INR, USD -> SETTLED IN INR)
     * =========================================================================
     */
    function convertToInr(amt, cur) {
      const lkrRate = Number(state.inrToLkr) > 0 ? Number(state.inrToLkr) : 3.55; // 1 INR = 3.55 LKR
      const usdRate = Number(state.usdToInr) > 0 ? Number(state.usdToInr) : 84.5; // 1 USD = 84.50 INR
      if (cur === "INR") return amt;
      if (cur === "USD") return amt * usdRate;
      return amt / lkrRate; // LKR -> INR
    }

    function calculateInrSettlement() {
      const paidInr = [0, 0];
      state.expenses.forEach((item) => {
        const valInr = convertToInr(Number(item.amt) || 0, item.cur || "LKR");
        paidInr[item.by] += valInr;
      });
      const totalInr = paidInr[0] + paidInr[1];
      const diffInr = paidInr[0] - totalInr / 2;
      return {
        totalInr,
        shareInr: totalInr / 2,
        paidInr,
        diffInr
      };
    }

