      if (diet === "both") {
        return `<span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-sky-100/90 text-sky-800 dark:bg-sky-950/80 dark:text-sky-300 border border-sky-200 dark:border-sky-800">🍽️ Veg + Famous Seafood/Local</span>`;
      }
      return "";
    }

    function renderVenueCard(item, stepNumber = null) {
      const checked = !!state.shortlist[item.id];
      const typeMeta = STOP_TYPES[item.type] || STOP_TYPES.v;
