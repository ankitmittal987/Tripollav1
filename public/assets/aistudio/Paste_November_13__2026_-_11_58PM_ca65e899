    /**
     * =========================================================================
     * MAIN RENDER LOOP & EVENT HANDLERS
     * =========================================================================
     */
    function render() {
      document.querySelectorAll(".nav-btn").forEach((btn) => {
        const isActive = btn.dataset.tab === state.tab;
        btn.classList.toggle("text-brand-600", isActive);
        btn.classList.toggle("dark:text-brand-400", isActive);
        btn.classList.toggle("text-slate-500", !isActive);
        btn.classList.toggle("dark:text-slate-400", !isActive);
        const pill = btn.querySelector(".nav-pill");
        if (pill) {
          pill.classList.toggle("bg-brand-100", isActive);
          pill.classList.toggle("dark:bg-brand-900/60", isActive);
        }
      });

      const app = $("app");
      if (state.tab === "plan") app.innerHTML = renderItineraryTab();
      else if (state.tab === "fly") app.innerHTML = renderFlightsTab();
      else if (state.tab === "money") app.innerHTML = renderExpensesTab();
      else app.innerHTML = renderToolsTab();
    }

    $("themeBtn").addEventListener("click", () => {
      const order = ["system", "light", "dark"];
      state.theme = order[(order.indexOf(state.theme) + 1) % order.length];
      store.set("theme", state.theme);
      applyTheme();
    });

    document.addEventListener("click", (ev) => {
      const btn = ev.target.closest("[data-tab], [data-day], [data-filter-shortlist], [data-copy], [data-add-exp], [data-del-exp], [data-share-exp], [data-copy-shortlist], [data-add-check], [data-export-json]");
      if (!btn) return;

      if (btn.dataset.tab) {
        state.tab = btn.dataset.tab;
        render();
        window.scrollTo({ top: 0, behavior: "smooth" });
      } else if (btn.dataset.day !== undefined) {
        state.day = Number(btn.dataset.day);
        render();
      } else if (btn.dataset.filterShortlist !== undefined) {
        state.onlyShortlisted = btn.dataset.filterShortlist === "1";
        store.set("only_shortlisted", state.onlyShortlisted);
        render();
      } else if (btn.dataset.copy) {
        copyText(btn.dataset.copy, btn.dataset.copyMsg || "Copied!");
      } else if ("addExp" in btn.dataset) {
        const amt = parseFloat($("expAmt").value);
        if (!(amt > 0)) {
          showToast("Please enter a valid amount");
          return;
        }
        const desc = $("expDesc").value.trim() || "Shared Expense";
        const cat = $("expCat").value;
        const cur = $("expCur").value;
        const by = Number($("expBy").value);
        state.expenses.unshift({ desc, cat, cur, amt, by });
        store.set("exp", state.expenses);
        render();
        const inrVal = convertToInr(amt, cur);
        showToast(`Added ${cur} ${amt} (≈ ₹${Math.round(inrVal)})`);
      } else if (btn.dataset.delExp !== undefined) {
        state.expenses.splice(Number(btn.dataset.delExp), 1);
        store.set("exp", state.expenses);
        render();
        showToast("Expense removed");
      } else if ("shareExp" in btn.dataset) {
        const calc = calculateInrSettlement();
        const n = state.names;
        const settled = Math.abs(calc.diffInr) < 0.5;
        const settleLine = settled
          ? "All settled up in INR!"
          : `${n[calc.diffInr > 0 ? 1 : 0]} owes ${n[calc.diffInr > 0 ? 0 : 1]} ₹${Math.abs(calc.diffInr).toFixed(2)}`;
        const summary = [
          `🌴 *Sri Lanka Trip Expenses (12–17 Dec)*`,
          `Rates: 1 INR = ${state.inrToLkr} LKR | 1 USD = ₹${state.usdToInr}`,
          `Total Trip: ₹${calc.totalInr.toFixed(2)}`,
          `• ${n[0]} paid: ₹${calc.paidInr[0].toFixed(2)}`,
          `• ${n[1]} paid: ₹${calc.paidInr[1].toFixed(2)}`,
          `👉 *${settleLine}*`
        ].join("\n");
        copyText(summary, "INR WhatsApp summary copied!");
      } else if ("copyShortlist" in btn.dataset) {
        const lines = [`🌴 *Sri Lanka Shortlisted Itinerary (12–17 Dec)*`];
        DAYS_DATA.forEach((d) => {
          const picked = d.items.filter((x) => state.shortlist[x.id]);
          lines.push(`\n*${d.title}*`);
          picked.forEach((p, idx) => lines.push(`${idx + 1}. ${p.name}`));
        });
        copyText(lines.join("\n"), "Shortlisted itinerary copied!");
      } else if ("addCheck" in btn.dataset) {
        const txt = $("newCheckText").value.trim();
        if (!txt) return;
        state.checklist.push({ id: "c_" + Date.now(), cat: "Custom", text: txt, done: false });
        store.set("checklist", state.checklist);
        render();
        showToast("Added to checklist");
      } else if ("exportJson" in btn.dataset) {
        const payload = {
          exportedAt: new Date().toISOString(),
          shortlist: state.shortlist,
          notes: state.notes,
          flightTimes: state.flightTimes,
          hotelName: state.hotelName,
          names: state.names,
          inrToLkr: state.inrToLkr,
          usdToInr: state.usdToInr,
          expenses: state.expenses,
          checklist: state.checklist
        };
        const blob = new Blob([JSON.stringify(payload, null, 2)], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = "sri-lanka-trip-ankit-laxit.json";
        a.click();
        URL.revokeObjectURL(url);
        showToast("Trip backup JSON downloaded");
      }
    });

    document.addEventListener("input", (ev) => {
      const t = ev.target;
      if (t.dataset.noteDay !== undefined) {
        state.notes[t.dataset.noteDay] = t.value;
        store.set("notes", state.notes);
      } else if (t.dataset.ft !== undefined) {
        state.flightTimes[t.dataset.ft] = t.value;
        store.set("ft", state.flightTimes);
      } else if (t.id === "hotelInput") {
        state.hotelName = t.value;
        store.set("hotel_name", state.hotelName);
      }
    });

    document.addEventListener("change", (ev) => {
      const t = ev.target;
      if (t.dataset.shortlistId !== undefined) {
        const id = t.dataset.shortlistId;
        state.shortlist[id] = t.checked;
        store.set("shortlist", state.shortlist);
        render();
        showToast(t.checked ? "Added to shortlist" : "Removed from shortlist");
      } else if (t.dataset.coupleName !== undefined) {
        const idx = Number(t.dataset.coupleName);
        state.names[idx] = t.value.trim() || (idx === 0 ? "Ankit Jeenat" : "Laxit Sayali");
        store.set("names", state.names);
        render();
      } else if ("rateLkr" in t.dataset) {
        const r = parseFloat(t.value);
        if (r > 0) {
          state.inrToLkr = r;
          store.set("inr_to_lkr", state.inrToLkr);
          render();
        }
      } else if ("rateUsd" in t.dataset) {
        const r = parseFloat(t.value);
        if (r > 0) {
          state.usdToInr = r;
          store.set("usd_to_inr", state.usdToInr);
          render();
        }
      } else if (t.dataset.checkIdx !== undefined) {
        const idx = Number(t.dataset.checkIdx);
        state.checklist[idx].done = t.checked;
        store.set("checklist", state.checklist);
        render();
      } else if (t.id === "importJsonFile" && t.files && t.files[0]) {
        const reader = new FileReader();
        reader.onload = (e) => {
          try {
            const data = JSON.parse(e.target.result);
            if (data.shortlist) { state.shortlist = { ...state.shortlist, ...data.shortlist }; store.set("shortlist", state.shortlist); }
            if (data.notes) { state.notes = data.notes; store.set("notes", state.notes); }
            if (data.flightTimes) { state.flightTimes = data.flightTimes; store.set("ft", state.flightTimes); }
            if (data.hotelName) { state.hotelName = data.hotelName; store.set("hotel_name", state.hotelName); }
            if (Array.isArray(data.names)) { state.names = data.names; store.set("names", state.names); }
            if (data.inrToLkr) { state.inrToLkr = data.inrToLkr; store.set("inr_to_lkr", state.inrToLkr); }
            if (data.usdToInr) { state.usdToInr = data.usdToInr; store.set("usd_to_inr", state.usdToInr); }
            if (Array.isArray(data.expenses)) { state.expenses = data.expenses; store.set("exp", state.expenses); }
            if (Array.isArray(data.checklist)) { state.checklist = data.checklist; store.set("checklist", state.checklist); }
            render();
            showToast("Trip data imported!");
          } catch (err) {
            showToast("Invalid backup JSON file");
          }
        };
        reader.readAsText(t.files[0]);
      }
    });

    applyTheme();
    render();
  </script>
</body>
</html>
